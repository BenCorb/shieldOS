<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS focus gloss: a soft diagonal sheen from the top left, fading out by the middle of the tile. The view is drawn
     at twice the tile's size (item_app.xml) so TvosFocusMotion can slide it without its edges showing. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#00FFFFFF"
        android:centerColor="#47FFFFFF"
        android:centerX="0.42"
        android:centerY="0.42"
        android:endColor="#00FFFFFF" />
</shape>
